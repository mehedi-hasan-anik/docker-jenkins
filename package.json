{
  "name": "turborepo-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "web:serve": "pnpm --filter web dev",
    "admin:serve": "pnpm --filter admin dev",
    "web:serve:production": "cd apps/web && pnpm start",
    "admin:serve:production": "cd apps/admin && pnpm start",
    "web:build": "pnpm --filter web build",
    "admin:build": "pnpm --filter admin build",
    "prettier": "prettier --cache --log-level warn .",
    "prettier:check": "pnpm prettier --check",
    "prettier:write": "pnpm prettier --write",
    "format": "pnpm prettier:write",
    "clear-cache": "rm -rf .turbo && find . -type d -name '.next' -exec rm -rf {} +",
    "clear-cache-and-build": "pnpm clear-cache && pnpm build",
    "remove-all": "rm -rf .turbo && find . -type d -name '.next' -exec rm -rf {} + && find . -type d -name 'node_modules' -exec rm -rf {} + && pnpm store prune",
    "remove-all-and-build": "pnpm remove-all && pnpm install && pnpm build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:reset": "docker rm -f monorepo-dev monorepo-container 2>/dev/null; docker compose -f docker-compose.dev.yml down --remove-orphans 2>/dev/null; docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "core-js",
      "core-js-pure",
      "sharp"
    ]
  }
}
